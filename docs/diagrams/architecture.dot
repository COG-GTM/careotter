// Careotter system architecture (main). Edit, then run ./render.sh.
digraph careotter {
  graph [rankdir=TB, fontname="DejaVu Sans", fontsize=20, labelloc=t, nodesep=0.35, ranksep=0.6, pad=0.3,
         label="Careotter architecture (main): clients -> API gateway -> 10 services -> data and event bus"];
  node  [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=16, fillcolor=white, color="#4a5568"];
  edge  [color="#4a5568", fontname="DejaVu Sans", fontsize=12];

  subgraph cluster_clients {
    label="Clients"; style="rounded,filled"; fillcolor="#ebf8ff"; color="#3182ce"; fontsize=18;
    web    [label="client-app (compose: web-app)\nReact 18 + Vite, nginx :3000\nfrontend/client-app"];
    native [label="Capacitor Android/iOS\n+ Electron desktop\n(same client-app bundle)"];
    admin  [label="admin-dashboard\nAngular 17, nginx :4200"];
    win    [label="Windows desktop client\nclients/windows-desktop"];
    {rank=same; web; native; admin; win;}
  }

  gw [label="api-gateway  :8080\nGo 1.22 / Chi\nJWT, rate limit, circuit breaker, /api/v1/* proxy", fillcolor="#fefcbf", color="#b7791f"];

  subgraph cluster_services {
    label="Backend services (docker-compose.yml, one Helm chart each)"; style="rounded,filled"; fillcolor="#f0fff4"; color="#38a169"; fontsize=18;
    auth   [label="auth-service :8081\nJava 17, Spring Boot 3.2"];
    file   [label="file-service :8082\nRust, Actix-Web 4"];
    doc    [label="document-service :8083\nPython 3.12, FastAPI"];
    collab [label="collab-service :8084\nNode 20, Socket.io + Yjs\n(HTTP + WebSocket)"];
    notif  [label="notification-service :8086\nKotlin 1.9, Ktor 2.3"];
    search [label="search-service :8087\nPython 3.12, Flask 3"];
    anl    [label="analytics-service :8088\nScala 3, Akka HTTP"];
    adm    [label="admin-service :8089\nRuby 3.3, Rails 7.1\nincidents -> Devin sessions"];
    aud    [label="audit-service :8090\nC#, ASP.NET Core 8"];
    rep    [label="report-service :8091\nJava 8, Spring Boot 2.5\n(legacy upgrade target)"];
    {rank=same; auth; file; doc; collab; notif;}
    {rank=same; search; anl; adm; aud; rep;}
  }

  subgraph cluster_data {
    label="Data and events (docker-compose.infra.yml; AWS emulated by LocalStack locally)"; style="rounded,filled"; fillcolor="#faf5ff"; color="#805ad5"; fontsize=18;
    pg    [label="PostgreSQL 15\notterworks,\notterworks_reports", shape=cylinder];
    redis [label="Redis 7\nsessions, rate limits,\ncollab state", shape=cylinder];
    meili [label="MeiliSearch 1.6", shape=cylinder];
    dyn   [label="DynamoDB\nfile metadata/versions/shares,\nfolders, notifications,\npreferences, audit events", shape=cylinder];
    s3    [label="S3\nfile blobs, data lake,\naudit archive", shape=cylinder];
    sns   [label="SNS otterworks-events\n-> SQS notifications /\naudit-events-queue /\nsearch-events"];
    {rank=same; sns; dyn; s3;}
    {rank=same; pg; redis; meili;}
  }

  subgraph cluster_side {
    label="Outside the gateway"; style="rounded,filled"; fillcolor="#fff5f5"; color="#c53030"; fontsize=18;
    lp  [label="legacy-portal :8095\nJava 11, Spring Boot 2.7\nmodular monolith, on-prem compose"];
    etl [label="etl/ cron jobs\nPython (etl/crontab)"];
    {rank=same; lp; etl;}
  }

  ext [label="Devin API", shape=note, fillcolor="#edf2f7"];

  web -> gw; native -> gw; admin -> gw; win -> gw;
  web -> collab [style=dashed, constraint=false, label="WebSocket"];
  gw -> {auth file doc collab notif search anl adm aud rep};

  auth -> pg; doc -> pg; adm -> pg; anl -> pg; rep -> pg;
  auth -> redis; collab -> redis; adm -> redis;
  file -> dyn; file -> s3; notif -> dyn; aud -> dyn; aud -> s3;
  search -> meili;
  file -> sns [label="publish"]; doc -> sns [label="publish"];
  sns -> notif [label="consume"]; sns -> aud [label="consume"]; sns -> search [label="index"];
  rep -> {anl aud auth} [style=dashed, constraint=false];
  adm -> ext [label="incident triage"];
  auth -> search [style=invis]; file -> anl [style=invis]; doc -> adm [style=invis];
  search -> sns [style=invis]; anl -> dyn [style=invis]; aud -> s3 [style=invis];
  sns -> pg [style=invis]; dyn -> redis [style=invis];
  pg -> lp [style=invis]; meili -> etl [style=invis];
}
